{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
  "changelog": [
    "@svitejs/changesets-changelog-github-compact",
    {
      "repo": "react-navigation/react-navigation-lynx"
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "tag": false,
    "version": false
  },
  "ignore": [
    "@react-navigation/example-stack"
  ],
  "changedFilePatterns": [
    "src/**"
  ],
  "snapshot": {
    "prereleaseTemplate": "{tag}-{datetime}-{commit}",
    "useCalculatedVersion": true
  }
}
