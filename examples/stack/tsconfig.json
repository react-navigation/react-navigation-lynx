{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "types": ["@rsbuild/core/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolvePackageJsonImports": false
  },
  "include": ["src", "rsbuild.config.ts"]
}
