{
  "name": "@react-navigation/lynx",
  "version": "0.1.0",
  "description": "Lynx integration for React Navigation",
  "keywords": [
    "react",
    "lynx",
    "react-navigation"
  ],
  "homepage": "https://reactnavigation.org",
  "bugs": {
    "url": "https://github.com/react-navigation/react-navigation-lynx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-navigation/react-navigation-lynx.git",
    "directory": "packages/lynx"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./stack": "./src/stack/index.tsx",
    "./react-compat": "./src/react-compat.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@react-navigation/core": "workspace:^"
  },
  "peerDependencies": {
    "@lynx-js/react": "*",
    "lynx-screens": "*"
  },
  "devDependencies": {
    "@lynx-js/react": "^0.125.0",
    "@lynx-js/testing-environment": "^0.3.3",
    "@lynx-js/types": "^4.1.0",
    "@types/react": "~19.2.17",
    "jsdom": "^26.0.0",
    "lynx-screens": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
